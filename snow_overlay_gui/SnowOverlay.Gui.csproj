<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <BaseOutputPath>bin\IconBuild\</BaseOutputPath>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\SnowOverlay.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\SnowOverlay.ico" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>

  <Target Name="BuildSnowOverlayEngine" BeforeTargets="Build">
    <Exec WorkingDirectory="$(MSBuildThisFileDirectory)..\snow_overlay" Command="&quot;$(USERPROFILE)\.cargo\bin\cargo.exe&quot; +stable build --release --target-dir target-gui" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\snow_overlay\target-gui\release\snow_overlay.exe"
          DestinationFiles="$(OutDir)snow_overlay.exe" />
  </Target>

  <Target Name="CopySnowOverlayEngineToPublishDirectory" AfterTargets="Publish">
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\snow_overlay\target-gui\release\snow_overlay.exe"
          DestinationFiles="$(PublishDir)snow_overlay.exe" />
  </Target>
</Project>
